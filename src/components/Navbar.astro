---
const links = [
  { href: '/', label: 'Home' },
  { href: '/#about', label: 'About' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#work', label: 'Work' },
  { href: '/blog', label: 'Blog' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/#contact', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href);
---

<header class="navbar">
  <nav class="container bar" aria-label="Main">
    <a class="brand" href="/">Reman<span>.</span></a>
    <button class="burger" aria-expanded="false" aria-controls="menu" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <ul id="menu" class="links">
      {links.map((l) => (
        <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .navbar { position: fixed; inset: 0 0 auto 0; z-index: 1000; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
  .bar { height: 68px; display: flex; align-items: center; justify-content: space-between; }
  .brand { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; color: var(--primary); }
  .brand span { color: var(--accent); }
  .links { display: flex; gap: 2rem; }
  .links a { font-size: 0.9rem; font-weight: 500; color: var(--muted); position: relative; padding: 0.25rem 0; }
  .links a:hover, .links a[aria-current] { color: var(--primary); }
  .links a::after { content: ''; position: absolute; left: 0; bottom: -2px; height: 2px; width: 0; background: var(--accent); transition: var(--ease); }
  .links a:hover::after, .links a[aria-current]::after { width: 100%; }
  .burger { display: none; background: none; border: 0; width: 44px; height: 44px; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
  .burger span { width: 22px; height: 2px; background: var(--primary); transition: var(--ease); }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    .burger { display: flex; }
    .links { position: absolute; top: 68px; left: 0; right: 0; flex-direction: column; gap: 0; background: var(--bg); border-bottom: 1px solid var(--border); padding: 0.5rem 1.25rem 1rem; display: none; }
    .links.open { display: flex; }
    .links a { display: block; padding: 0.85rem 0; font-size: 1rem; }
    .links a::after { display: none; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('menu');
  const set = (open: boolean) => {
    menu?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && set(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
</script>
