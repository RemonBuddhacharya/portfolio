---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/content';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, date, summary, cover, coverAlt, tags, draft } = post.data;
---

<article class="card" data-tags={tags.join('|').toLowerCase()} data-text={`${title} ${summary}`.toLowerCase()}>
  <a href={`/blog/${post.id}`} class="link">
    <div class="thumb">
      {cover
        ? <Image src={cover} alt={coverAlt} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 360px" />
        : <div class="ph" aria-hidden="true">{title.charAt(0)}</div>}
    </div>
    <div class="body">
      <p class="meta">{formatDate(date)} · {readingTime(post.body)} min read {draft && <strong>· DRAFT</strong>}</p>
      <h3>{title}</h3>
      <p class="sum">{summary}</p>
      {tags.length > 0 && <p class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
    </div>
  </a>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: var(--ease); height: 100%; }
  .card:hover { border-color: var(--accent); transform: translateY(-4px); box-shadow: 0 20px 40px -16px rgba(15, 23, 42, 0.18); }
  .link { display: flex; flex-direction: column; height: 100%; }
  .thumb { aspect-ratio: 16 / 9; background: var(--accent-soft); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
  .card:hover .thumb img { transform: scale(1.04); }
  .ph { height: 100%; display: grid; place-items: center; font-size: 4rem; font-weight: 800; color: var(--accent); opacity: 0.5; }
  .body { padding: 1.4rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .meta { font-size: 0.8rem; color: var(--muted); }
  h3 { font-size: 1.2rem; line-height: 1.35; color: var(--primary); }
  .sum { color: var(--muted); font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 0.5rem; }
  @media (hover: none) { .card:hover { transform: none; } }
</style>
