---
import { Image } from 'astro:assets';
import { getAlbums } from '../lib/content';
const photos = (await getAlbums()).flatMap((a) => a.data.photos).slice(0, 6);
---

{photos.length > 0 && (
  <section class="section" id="photos">
    <div class="container">
      <h2 class="section-title">Through My Lens</h2>
      <ul class="strip">
        {photos.map((p) => (
          <li><a href="/gallery"><Image src={p.image} alt={p.alt} widths={[300, 500]} sizes="(max-width: 600px) 50vw, 33vw" loading="lazy" /></a></li>
        ))}
      </ul>
      <p class="more"><a class="btn secondary" href="/gallery">Open the gallery</a></p>
    </div>
  </section>
)}

<style>
  .strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .strip a { display: block; aspect-ratio: 1; border-radius: 12px; overflow: hidden; }
  .strip img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 0.5s; }
  .strip a:hover img { transform: scale(1.06); }
  @media (max-width: 600px) { .strip { grid-template-columns: repeat(2, 1fr); } }
</style>
