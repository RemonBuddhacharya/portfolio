---
import { settings } from '../lib/content';
---

<section class="hero">
  <div class="container">
    <h1>{settings.name}</h1>
    <p class="job">{settings.jobTitle}</p>
    <p class="sub">{settings.tagline}</p>
    <div class="buttons">
      <a href="/#work" class="btn primary">View Work</a>
      {settings.resume && <a href={`/files/${settings.resume}`} class="btn secondary" download>Download CV</a>}
      <a href="/blog" class="btn secondary">Read the Blog</a>
    </div>
  </div>
</section>

<style>
  .hero { min-height: 100svh; display: flex; align-items: center; text-align: center; padding: 120px 0 72px; }
  h1 { font-size: clamp(2.5rem, 9vw, 4.8rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.1; color: var(--primary); }
  .job { margin: 0.75rem 0 2rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.18em; font-size: clamp(0.85rem, 2.5vw, 1.15rem); color: var(--accent); }
  .sub { max-width: 760px; margin: 0 auto 2.5rem; font-size: clamp(1rem, 2.5vw, 1.2rem); color: var(--muted); line-height: 1.8; }
  .buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
