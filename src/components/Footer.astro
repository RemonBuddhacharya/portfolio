---
import { settings } from '../lib/content';
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p class="links">
      <a href={settings.github} rel="noopener">GitHub</a>
      <a href={settings.linkedin} rel="noopener">LinkedIn</a>
      <a href="/rss.xml">RSS</a>
    </p>
    <p>© {year} {settings.name} · {settings.jobTitle}</p>
  </div>
</footer>

<style>
  footer { background: #0f172a; color: #94a3b8; text-align: center; padding: 3.5rem 0; font-size: 0.95rem; }
  .links { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 1rem; }
  .links a { color: #e2e8f0; }
  .links a:hover { color: #60a5fa; }
</style>
